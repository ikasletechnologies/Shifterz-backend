  status              String
  odometer            String
  notes               String
  jobCardId           String
  franchiseId         String?
  receivedById        String?
  receivedByName      String?
  fuelLevel           String?
  keyCount            Int?       @default(1)
  expectedDelivery    DateTime?
  scratches           String?
  dents               String?
  brokenParts         String?
  glassDamage         String?
  wheelDamage         String?
  interiorCondition   String?
  accessoriesReceived String?
  remarks             String?
