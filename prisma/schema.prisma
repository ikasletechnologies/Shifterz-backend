}

// GST-01 — this model already existed (name/percentage/franchiseId/status)
// but was completely unwired anywhere in the codebase. Repurposed as the GST
// rate master rather than creating a second, duplicate model: added
// effective-dating so a rate change never retroactively alters an already-
// issued invoice's stored GST snapshot (which reads the rate that was active
// on the invoice's date, not TaxMaster's current value).
model TaxMaster {
  id            String    @id @default(cuid())
  name          String
  percentage    Float
  franchiseId   String?
  status        String    @default("Active")
  effectiveFrom DateTime?
  effectiveTo   DateTime?
}

// GST-01 — SAC/HSN code lookup. Kept independent of Service.hsnSac (a plain
// string) rather than an enforced foreign key, consistent with how master
// data is referenced elsewhere in this schema.
model HsnSacMaster {
  id             String    @id @default(cuid())
  code           String    @unique
  description    String
  type           String    // "SAC" | "HSN"
  defaultGstRate Float?
  status         String    @default("Active")
  createdAt      DateTime  @default(now())
}

model DiscountMaster {
