// ═══════════════════════════════════════════════════════════════
// VENDOR & PURCHASE MANAGEMENT (§Vendor & Purchase Management)
// ═══════════════════════════════════════════════════════════════

model Vendor {
  id         String          @id @default(cuid())
  code       String          @unique
  name       String
  gstNumber  String?
  contact    String?
  phone      String?
  email      String?
  address    String?
  state      String?   // GST-08 — needed alongside gstNumber to determine intra/inter-state on a purchase, same role Franchise/Customer.state already play for sales
  status     String          @default("Active")
  isDeleted  Boolean         @default(false)
  deletedAt  DateTime?
  createdAt  DateTime        @default(now())
  purchases  PurchaseOrder[]
}

model PurchaseOrder {
  id             String    @id @default(cuid())
  orderNumber    String    @unique // e.g. PO-2026-0001
  vendorId       String
  vendor         Vendor    @relation(fields: [vendorId], references: [id])
  vendorName     String
  stage          String    @default("REQUESTED") // REQUESTED -> ORDERED -> RECEIVED -> INVOICED -> PAID
  items          String    // JSON string: [{ name, sku, qty, unitPrice, total }]
  totalAmount    Float
  paidAmount     Float     @default(0)
  invoiceNumber  String?   // Purchase Invoice Number
  receivedAt     DateTime? // Goods Receipt Timestamp
  paidAt         DateTime? // Supplier Payment Timestamp
  notes          String?
  createdBy      String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  // GST-08 — input-GST snapshot for the attached purchase invoice, same
  // immutability principle as the sales-side Invoice snapshot (GST-01).
  // Nullable throughout: existing purchase orders keep working with none of
  // this populated. Nothing currently writes these fields or a matching
  // GstTransaction(documentType='PURCHASE') row — deciding who resolves the
  // vendor's GSTIN/state, how the GST breakdown gets computed, and what
  // makes a line ITC-eligible is a business-workflow question, deferred the
  // same way GST-04 deferred CN/DN issuance.
  vendorGstin    String?
  vendorState    String?
  invoiceDate    DateTime?
  hsnSac         String?    // simplified single-group snapshot, same limitation as Invoice.hsnSac — see PurchaseOrderLine for the real per-line breakdown
  taxableValue   Float?
  cgst           Float?
  sgst           Float?
  igst           Float?
  cess           Float?
  itcEligible    Boolean?
  itcClaimed     Boolean   @default(false)
  // Purchase GST/ITC foundation — snapshot at invoice-attachment time,
  // mirroring Invoice.placeOfSupply/supplyType exactly (frozen so a later
  // change to Vendor.state or the company's own GST config never alters an
  // already-attached purchase invoice's classification). Reverse charge is
  // explicitly out of scope for this phase — no field added for it; every
  // purchase this system resolves GST for is treated as a standard (non-RCM)
  // supply until a future phase decides otherwise.
  placeOfSupply  String?
  supplyType     String?    // "B2B" | "B2C"
  lines          PurchaseOrderLine[]
}

// Purchase GST/ITC foundation — additive alongside the existing `items` Json
// field on PurchaseOrder, which is left untouched for backward compatibility
// (nothing currently reads/writes it changes here). Mirrors InvoiceLine's
// shape exactly: one row per GST rate/HSN group on the purchase invoice.
// `sku`/`productRef` is a plain reference, not an enforced FK — same
// convention as InvoiceLine.serviceId and Job.services (matched by value,
// not id).
model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  description     String
  sku             String?
  hsnSac          String?
  quantity        Float         @default(1)
  unitPrice       Float
  taxableAmount   Float
  gstRate         Float
  cgst            Float         @default(0)
  sgst            Float         @default(0)
  igst            Float         @default(0)
  cess            Float         @default(0)
  lineTotal       Float
  itcEligible     Boolean       @default(false)
}

// ──────────────────────────────────────────────────────────────
// MASTERS & CONFIGURATION (§Masters) — HQ Only
// A single flexible model powers all master data categories.
// category field values:
//   Customer Masters : CUSTOMER_TYPE, LEAD_SOURCE, REFERRAL_TYPE
//   Vehicle Masters  : VEHICLE_BRAND, VEHICLE_MODEL, FUEL_TYPE, COLOUR
//   Employee Masters : DEPARTMENT, DESIGNATION, ROLE
//   Inventory Masters: PRODUCT_CATEGORY, UNIT_OF_MEASURE, BRAND
//   Finance Masters  : GST_RATE, PAYMENT_MODE, DISCOUNT_TYPE
//   System Masters   : NOTIFICATION_TEMPLATE, NUMBER_SERIES,
//                      BUSINESS_HOURS, HOLIDAY_CALENDAR
// ──────────────────────────────────────────────────────────────
model MasterData {
  id          String    @id @default(cuid())
  category    String    // e.g. "VEHICLE_BRAND", "FUEL_TYPE", "GST_RATE"
  code        String?   // optional short code / slug
  name        String    // display name
  value       String?   // optional additional value (e.g. tax %, hours JSON)
  parentId    String?   // for hierarchical masters (e.g. Model → Brand)
  sortOrder   Int       @default(0)
  status      String    @default("Active") // "Active" | "Inactive"
  createdBy   String?
  isDeleted   Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([parentId])
}




