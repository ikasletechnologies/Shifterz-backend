generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Lead {
  id                  String                  @id
  name                String
  phone               String
  alternateNumber     String?
  email               String
  city                String?
  source              String
  service             String
  vehicle             String
  vehicleMake         String?
  vehicleModel        String?
  assignedTo          String
  assignedToId        String?
  assignedBy          String?
  assignedAt          DateTime?
  status              String
  notes               String
  budget              String
  priority            String?                 @default("Medium")
  date                DateTime
  franchiseId         String?
  originalFranchiseId String?                 // Preserved original franchise on transfer
  customerId          String?                 // Set once the lead is converted → Customer
  convertedAt         DateTime?               // Timestamp of conversion
  lostReason          String?                 // Reason when marked as Lost
  isDeleted           Boolean                 @default(false)
  deletedAt           DateTime?
  franchise           Franchise?              @relation(fields: [franchiseId], references: [id])
  assignmentHistory   LeadAssignmentHistory[]
  transferHistory     LeadTransferHistory[]
  followUps           LeadFollowUp[]
}

model LeadAssignmentHistory {
  id           String   @id @default(cuid())
  leadId       String
  assignedTo   String
  assignedToId String?
  assignedBy   String
  assignedAt   DateTime @default(now())
  reason       String?
  lead         Lead     @relation(fields: [leadId], references: [id])
}

model LeadTransferHistory {
  id                String   @id @default(cuid())
  leadId            String
  fromFranchiseId   String?
  fromFranchiseName String?
  toFranchiseId     String?
  toFranchiseName   String?
  transferredBy     String
  transferredAt     DateTime @default(now())
  reason            String?
  lead              Lead     @relation(fields: [leadId], references: [id])
}

model LeadFollowUp {
  id               String   @id @default(cuid())
  leadId           String
  // When the follow-up happened
  followUpDate     DateTime
  // Who performed it
  performedById    String?
  performedBy      String
  // Communication mode
  mode             String   // "Phone Call", "WhatsApp", "SMS", "Email", "Meeting", "Walk-In", "Other"
  // What was discussed
  notes            String
  // Outcome / result of this interaction
  outcome          String?  // "Interested", "Not Interested", "Callback Requested", "No Response", "Deal Closed"
  // What to do next
  nextAction       String?
  // Optional: schedule the next follow-up
  nextFollowUpDate DateTime?
  // Lead status at the time of this follow-up (or updated by this follow-up)
  leadStatusUpdate String?
  franchiseId      String?  // franchise at the time of follow-up
  createdAt        DateTime @default(now())
  lead             Lead     @relation(fields: [leadId], references: [id])
}


model Invoice {
  id                  String     @id
  type                String
  client              String
  phone               String
  vehicle             String
  service             String
  amount              Float
  gst                 Float
  discount            Float
  status              String
  date                DateTime
  dueDate             DateTime
  notes               String
  gstNumber           String?
  items               Json?
  bankDetails         String?
  paymentTerms        String?
  deliveryTerms       String?
  authorizedSignatory String?
  franchiseId         String?
  jobId               String?    // Optional link to the Job this invoice bills (10.11 revenue attribution)
  warranty            String?
  cancelReason        String?
  discountReason      String?
  numberPrefix        String?    // e.g. "STZ-25-26-" — captured at creation so delete/cancel never re-parse the id
  sequenceNumber      Int?       // the numeric suffix allocated from InvoiceSequence at creation
  isDeleted           Boolean    @default(false)
  deletedAt           DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @default(now()) @updatedAt
  createdBy           String?
  modifiedBy          String?
  cancelledBy         String?
  approvedBy          String?
  // GST-01 — immutable GST snapshot, captured once at invoice creation by the
  // (future, GST-02) calculation engine and never recomputed afterward, so a
  // later change to a service's rate or a franchise's GST config never alters
  // an already-issued invoice. All nullable: existing invoices keep working
  // with none of these populated. `gstNumber` above already existed and is
  // reused as the buyer GSTIN snapshot — not duplicated here. The existing
  // `gst` field remains the total GST amount; cgst+sgst+igst+cess is its
  // breakdown, not a second total.
  sellerGstin         String?
  sellerState         String?
  buyerState          String?
  placeOfSupply       String?
  supplyType          String?    // "B2B" | "B2C"
  taxableAmount       Float?
  cgst                Float?
  sgst                Float?
  igst                Float?
  cess                Float?
  hsnSac              String?    // simplified invoice-level snapshot; single-group case only, see GST-04's InvoiceLine for the full per-line breakdown
  gstCalculationMeta  Json?
  franchise           Franchise? @relation(fields: [franchiseId], references: [id])
  job                 Job?       @relation(fields: [jobId], references: [id])
  // GST-04 — structured per-line GST detail. Additive: `items` (Json) above
  // is untouched and still populated exactly as before; nothing currently
  // reads invoiceLines, so no existing invoice needs one for this schema
  // change to be safe. Cascades on invoice delete because these rows have no
  // independent existence of their own — unlike Payment (Step 3 Item #1
  // explicitly stopped cascading Payment deletes, because a payment is an
  // independent financial record with its own audit significance; a line
  // item is not, it's a component of the invoice itself).
  invoiceLines        InvoiceLine[]
  creditNotes         CreditNote[]
  debitNotes          DebitNote[]
}

// GST-04 — structured replacement for reading Invoice.items as an opaque
// blob. Each line snapshots its own rate/HSN at billing time (never a live
// reference to Service, which can change rate later) — same immutability
// principle as the invoice-level GST snapshot from GST-01.
model InvoiceLine {
  id            String   @id @default(cuid())
  invoiceId     String
  invoice       Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceId     String?  // plain reference, not an enforced FK — matches how Job.services already matches Service by name, not id
  description   String
  quantity      Float    @default(1)
  unitPrice     Float
  discount      Float    @default(0)
  hsnSac        String?
  gstRate       Float
  taxableAmount Float
  cgst          Float    @default(0)
  sgst          Float    @default(0)
  igst          Float    @default(0)
  cess          Float    @default(0)
  lineTotal     Float
  createdAt     DateTime @default(now())
}

// GST-04 — a GST Credit Note is a statutory tax document, NOT a financial
// refund. `linkedPaymentId` is a deliberately loose, optional, non-enforced
// cross-reference for when the two happen to relate to the same event — it
// must never become the mechanism that creates one from the other. No
// service/workflow logic reads or writes this model yet; that's a distinct,
// later phase (deciding when/how a credit note actually gets issued is a
// business-workflow question, not a schema one). `originalInvoiceId` has no
// onDelete cascade — deleting the source invoice (already an exceptional,
// SUPER_ADMIN-only, cancelled-and-payment-free operation per Step 3 Item #1)
// must not silently take a statutory correction document down with it; the
// database's own FK constraint blocks that deletion while a credit/debit
// note still references the invoice.
model CreditNote {
  id                String           @id @default(cuid())
  number            String           @unique
  date              DateTime         @default(now())
  franchiseId       String?
  originalInvoiceId String
  originalInvoice   Invoice          @relation(fields: [originalInvoiceId], references: [id])
  customerId        String?
  reason            String
  taxableAmount     Float
  cgst              Float            @default(0)
  sgst              Float            @default(0)
  igst              Float            @default(0)
  cess              Float            @default(0)
  totalTax          Float
  totalAmount       Float
  status            String           @default("Issued") // "Issued" | "Cancelled" — never hard-deleted
  createdBy         String?
  linkedPaymentId   String?          // optional, non-enforced — see model comment; NOT the same concept as a refund
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  lines             CreditNoteLine[]
}

model CreditNoteLine {
  id            String     @id @default(cuid())
  creditNoteId  String
  creditNote    CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)
  description   String
  hsnSac        String?
  quantity      Float      @default(1)
  rate          Float
  taxableAmount Float
  gstRate       Float
  cgst          Float      @default(0)
  sgst          Float      @default(0)
  igst          Float      @default(0)
  cess          Float      @default(0)
  lineTotal     Float
}

// GST-04 — mirrors CreditNote exactly; same statutory-document-not-a-payment
// distinction applies. A Debit Note increases, rather than reduces, the
// output tax liability against the original invoice.
model DebitNote {
  id                String          @id @default(cuid())
  number            String          @unique
  date              DateTime        @default(now())
  franchiseId       String?
  originalInvoiceId String
  originalInvoice   Invoice         @relation(fields: [originalInvoiceId], references: [id])
  customerId        String?
  reason            String
  taxableAmount     Float
  cgst              Float           @default(0)
  sgst              Float           @default(0)
  igst              Float           @default(0)
  cess              Float           @default(0)
  totalTax          Float
  totalAmount       Float
  status            String          @default("Issued")
  createdBy         String?
  linkedPaymentId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  lines             DebitNoteLine[]
}

model DebitNoteLine {
  id            String    @id @default(cuid())
  debitNoteId   String
  debitNote     DebitNote @relation(fields: [debitNoteId], references: [id], onDelete: Cascade)
  description   String
  hsnSac        String?
  quantity      Float     @default(1)
  rate          Float
  taxableAmount Float
  gstRate       Float
  cgst          Float     @default(0)
  sgst          Float     @default(0)
  igst          Float     @default(0)
  cess          Float     @default(0)
  lineTotal     Float
}

// GST-05 — the single normalized reporting source, per the architecture
// locked across GST-01 through GST-04: resolve -> calculate -> snapshot ->
// ledger -> reports. References the original document by (documentType,
// documentId) rather than owning/duplicating its business data — this table
// is a reporting index, not a second source of truth. documentId is a plain
// string, not an enforced FK: it points at one of five different tables
// depending on documentType, which Prisma has no native polymorphic-relation
// support for, so a loose reference is the correct mechanism here, not a
// shortcut. Only INVOICE rows are populated so far (see billing.service.ts) —
// CREDIT_NOTE/DEBIT_NOTE/REFUND/PURCHASE exist in the type vocabulary but
// nothing writes them yet, matching GST-04's explicit deferral of the CN/DN
// issuance workflow and the equivalent not-yet-decided question of how a
// refund or purchase should map onto this ledger.
model GstTransaction {
  id             String   @id @default(cuid())
  franchiseId    String?
  documentType   String   // "INVOICE" | "CREDIT_NOTE" | "DEBIT_NOTE" | "REFUND" | "PURCHASE"
  documentId     String
  documentNumber String
  documentDate   DateTime
  returnPeriod   String   // "YYYY-MM", derived from documentDate — never client-supplied
  sellerGstin    String?
  buyerGstin     String?
  buyerName      String?  // GST-07 — needed for GSTR-1's Customer Name column; the invoice snapshot has client name but the ledger didn't carry it until now
  sellerState    String?
  placeOfSupply  String?
  supplyType     String?  // "B2B" | "B2C"
  // GST-07 — a ledger row is now one (rate, HSN) group, not one aggregate
  // per invoice (amends GST-05's original one-row-per-invoice granularity).
  // GSTR-1's HSN-wise and rate-wise summaries are meaningless at
  // aggregate-invoice granularity for a multi-rate invoice, so this had to
  // change before GSTR-1 could be built correctly rather than approximately.
  hsnSac         String?
  gstRate        Float?
  taxableValue   Float
  cgst           Float    @default(0)
  sgst           Float    @default(0)
  igst           Float    @default(0)
  cess           Float    @default(0)
  // GST-08 — only meaningful for documentType='PURCHASE' rows (input tax);
  // null for INVOICE/CREDIT_NOTE/DEBIT_NOTE (output tax, no ITC concept).
  // Carried on the ledger row itself so GSTR-3B's input-tax-credit total
  // never has to join back to PurchaseOrder to know eligibility.
  itcEligible    Boolean?
  // Mirrors the source document's own status (e.g. an invoice getting
  // cancelled) — not an independently editable field on this ledger row.
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([franchiseId])
  @@index([returnPeriod])
  @@index([documentType, documentId])
}

// Race-safe invoice numbering (13.12): counter is the highest sequence number ever
// issued for a given prefix (e.g. "STZ-25-26-"). Allocated via atomic upsert on create;
// stepped back on delete only if the deleted invoice was the most recent one issued.
model InvoiceSequence {
  prefix  String @id
  counter Int    @default(0)
}

// Race-safe receipt numbering: counter is the highest sequence number ever
// issued for a given prefix (e.g. "RCPT-25-26-").
model ReceiptSequence {
  prefix  String @id
  counter Int    @default(0)
}

model Payment {
  id                 String     @id
  invoiceId          String?
  jobId              String?
  customerId         String?
  client             String
  amount             Float
  outstandingBalance Float?
  mode               String
  multipleModes      Json?      // e.g. [{mode: 'Cash', amount: 5000}, {mode: 'UPI', amount: 10000}]
  type               String     @default("Full Payment") // "Advance Payment", "Full Payment", "Partial Payment", "Refund", "Credit Sale"
  receiptNumber      String?    @unique
  date               DateTime
  ref                String?
  notes              String?
  refundReason       String?
  originalReceiptRef String?
  approvedBy         String?
  franchiseId        String?
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @default(now()) @updatedAt
  createdBy          String?
  franchise          Franchise? @relation(fields: [franchiseId], references: [id])
}

model Inventory {
  id          String     @id
  name        String
  unit        String
  category    String
  stock       Int
  reorder     Int
  cost        Float
  supplier    String
  location    String
  franchiseId String?
  isDeleted   Boolean    @default(false)
  deletedAt   DateTime?
  franchise   Franchise? @relation(fields: [franchiseId], references: [id])
}

model Service {
  id        String    @id
  code      String?   @unique
  name      String
  category  String
  price     Float
  minPrice  Float     @default(0)
  gst       Float     @default(18)
  duration  String
  warranty  String
  desc      String
  status    String    @default("Active")
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  // GST-01 — `gst` above is already the applicable rate; these two are the
  // only fields this model was missing for GST invoicing. hsnSac is a plain
  // string (not an FK to HsnSacMaster) to match how other master-data
  // references already work in this schema (e.g. Job/Invoice service line
  // items are copied snapshots, not live foreign keys).
  hsnSac        String?
  taxApplicable Boolean @default(true)
}

model Franchise {
  id                String             @id
  name              String
  city              String
  owner             String
  phone             String
  since             DateTime
  revenue           Float
  jobs              Int
  royaltyPct        Float
  status            String
  businessName      String?
  gstNumber         String?
  email             String?
  address           String?
  state             String?
  pinCode           String?
  licenseStatus     String?            @default("Active")
  canTransferLeads  Boolean            @default(false) // HQ grants Franchise Manager transfer permission
  // GST-01 — franchise's own GST registration type ("Regular" | "Composition" |
  // "Unregistered"). gstNumber/state above already existed and are reused as
  // the seller GSTIN/state for invoice GST snapshots; this is the only new
  // field this model needs.
  gstRegistrationType String?
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  appointments      Appointment[]
  attendances       Attendance[]
  carIns            CarIn[]
  customers         Customer[]
  employees         Employee[]
  inventory         Inventory[]
  inventoryRequests InventoryRequest[]
  inventoryAdjustmentRequests InventoryAdjustmentRequest[]
  invoices          Invoice[]
  jobsList          Job[]
  leads             Lead[]
  outPasses         OutPass[]
  payments          Payment[]
  leaveRequests     LeaveRequest[]
  estimates         Estimate[]
  workflowStages    WorkflowStage[]
  qcChecklistTemplates QCChecklistTemplate[]
}

model Customer {
  id               String            @id
  name             String
  phone            String
  email            String
  vehicle          String
  model            String
  visits           Int
  totalSpend       Float
  lastVisit        DateTime
  city             String?           // preserved from lead
  vehicleMake      String?
  vehicleModel     String?
  alternateNumber  String?
  convertedLeadId  String?           @unique // the lead that generated this customer
  convertedAt      DateTime?                 // when conversion happened
  rewardPoints     Int               @default(0)
  franchiseId      String?
  dob              DateTime?
  anniversary      DateTime?
  gstNumber        String?
  address          String?
  state            String?
  pinCode          String?
  status           String            @default("Active") // "Active", "Inactive"
  isDeleted        Boolean           @default(false)
  deletedAt        DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @default(now()) @updatedAt
  franchise        Franchise?        @relation(fields: [franchiseId], references: [id])
  vehicles         CustomerVehicle[]
  warranties       Warranty[]
  reminders        ServiceReminder[]
  estimates        Estimate[]
  complaints       CustomerComplaint[]
}

model CarIn {
  id                  String     @id
