  hasFastag           Boolean    @default(false)
  hasDashCam          Boolean    @default(false)
  hasUsbCharger       Boolean    @default(false)
  otherAccessories         String?
  // Check-Out / Delivery fields
  checkOutAt               DateTime?
  checkOutById             String?
  checkOutByName           String?
  customerAcknowledgement  String?
  isDeleted                Boolean    @default(false)
  deletedAt                DateTime?
  createdAt                DateTime   @default(now())
  updatedAt                DateTime   @default(now()) @updatedAt
  franchise                Franchise? @relation(fields: [franchiseId], references: [id])
}

model Job {
  id                     String          @id
  vehicle                String
  customer               String
  service                String
  services               Json?           // Array of service line items [{name, price, qty}]
  technician             String
  status                 String
  priority               String
  startDate              DateTime
  estCompletion          DateTime
  actualCompletion       DateTime?
  notes                  String
  remarks                String?         // Additional remarks on the job
  carInId                String?         // Reference to CarIn check-in
  customerSignature      String?
  companyAcknowledgement String?
  photos                 String[]
    inspectionDetails      Json?        // Vehicle inspection information
    checkInPhotos          String[] @default([])  // Check‑in photographs
    workProgressPhotos     String[] @default([])  // Photographs during work
    completionPhotos       String[] @default([])  // Final delivery photographs
    technicianInstructions String?   // Instructions for technicians, visible only on workshop copy
    internalRemarks        String?   // Private staff notes, not exposed to customers

  technicianId           String?
  serviceAdvisorId       String?
  serviceAdvisor         String?
  qcNotes                String?
  passedAt               DateTime?
  failedAt               DateTime?
  checklist              Json?
  qcPhotos               String[]        @default([])
  qcById                 String?
  qcBy                   String?
  isRework               Boolean         @default(false)
  reworkCount            Int             @default(0)
  qcAttemptCount         Int             @default(0)
  franchiseId            String?
  assignmentLocked       Boolean         @default(false)
  assignedBy             String?
  assignedByRole         String?
  supportingTechnicianIds String[]       @default([]) // Optional supporting employees (10.3)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @default(now()) @updatedAt
  isDeleted              Boolean         @default(false)
  deletedAt              DateTime?
  franchise              Franchise?      @relation(fields: [franchiseId], references: [id])
  additionalWorks        AdditionalWork[]
  jobPhotos              JobPhoto[]
  workNotes              WorkNote[]
  materialConsumptions   MaterialConsumption[]
  invoicesList           Invoice[]
  complaints             CustomerComplaint[]
  jobHistories           JobHistory[]
  qcInspections          QCInspection[]
}


model JobHistory {
  id        String   @id @default(uuid())
  jobId     String
  event     String   // e.g., "CREATED", "STATUS_CHANGED", "SERVICE_ADDED", "SERVICE_REMOVED", "PRICE_UPDATED", "WARRANTY_UPDATED", "ADDITIONAL_WORK_APPROVED", "QC_COMPLETED", "BILLING_COMPLETED", "VEHICLE_DELIVERED"
  performedBy String   // employee ID or system
  payload   Json?    // optional details of the change
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id])
}

model AdditionalWork {
  id             String    @id
  jobId          String
  description    String
  estimatedCost  Float
  status         String    @default("Pending") // Pending | Approved | Rejected
  requestedById  String?
  requestedBy    String?
  approvedById   String?
  approvedBy     String?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionNote  String?
  customerApproved Boolean @default(false) // Customer approval obtained before work begins (10.14.4)
  franchiseId    String?
  isDeleted      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model OutPass {
  id             String     @id
  vehicle        String
  model          String
  customer       String
  phone          String
  service        String
  outTime        DateTime
  securityName   String
  technicianName String
  remarks        String
  issued         Boolean
  carInId        String
  jobCardId      String?
  invoiceId      String?
  paymentStatus  String?
  createdBy      String?
  franchiseId    String?
  status         String     @default("Pending") // "Pending", "Approved", "Rejected"
  approvedBy     String?
  approvedAt     DateTime?
  isDeleted      Boolean    @default(false)
  deletedAt      DateTime?
  franchise      Franchise? @relation(fields: [franchiseId], references: [id])
}

model Setting {
  id                String    @id @default("default")
  companyName       String
  companyLogo       String?
  gstin             String
  panNumber         String?
  registeredAddress String?
  branchAddress     String?
  city              String?
  state             String?
  country           String?
  pinCode           String?
  address           String
  phone             String
  email             String
  website           String?
  gstPct            Float
  currency          String
  agents            String[]
  categories        String[]
  leadSources       String[]
  leadStatuses      String[]
  lostReasons       String[]
  securityGuards    String[]
  referralProgram   Json?
  loyaltyProgram    Json?
  workingHours      Json?
  notificationTemplates Json?
  numberingSeries   Json?
  isDeleted         Boolean   @default(false)
  deletedAt         DateTime?
}

model Employee {
  id           String          @id
  name         String
  phone        String?
  email        String?
  status       String          @default("Active")
  approvalStatus String        @default("Approved")
  username     String?         @unique
  password     String?
  role         String          @default("TECHNICIAN")
  hqControlled Boolean         @default(false)
  franchiseId  String?
  isDeleted    Boolean         @default(false)
  deletedAt    DateTime?
  attendances  Attendance[]
  franchise    Franchise?      @relation(fields: [franchiseId], references: [id])
  permission   UserPermission?
  sessions     Session[]
  leaveRequests LeaveRequest[]
  gender        String?
  dob           DateTime?
  doj           DateTime?
  department    String?
  designation   String?
  reportingManager String?
}

// Server-side login-session record. One row per issued JWT (keyed by its
// unique `jti` claim). Lets the API revoke a specific session (logout),
// all sessions for an employee (password change, deactivation), and reject
// requests bearing a token whose session has been revoked or expired —
// closing the "stateless JWT can never be invalidated" gap (Phase 0.4-0.7).
model Session {
  id            String    @id @default(cuid())
  employeeId    String
  jti           String    @unique
  issuedAt      DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  ipAddress     String?
  device        String?
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
}

model Attendance {
  id             String     @id @default(cuid())
  employeeId     String
  date           DateTime
  status         String
  clockIn        DateTime?
  clockOut       DateTime?
  workingHours   Float?
  lateArrival    Boolean?   @default(false)
  earlyDeparture Boolean?   @default(false)
  franchiseId    String?
  isDeleted      Boolean    @default(false)
  deletedAt      DateTime?
  employee       Employee   @relation(fields: [employeeId], references: [id])
  franchise      Franchise? @relation(fields: [franchiseId], references: [id])
}

model InventoryRequest {
  id                String     @id @default(cuid())
  itemId            String
  quantityRequested Int
  quantityApproved  Int?
  status            String
  date              DateTime
  requiredDate      DateTime?
  priority          String?    @default("Medium")
  remarks           String?
  franchiseId       String?
  // INV-05 — additive, nullable. Needed to detect and block an HQ_USER
  // approving their own request (no franchiseId scope separates an HQ_USER
  // from other HQ_USERs the way it does for franchise requesters). Legacy
  // rows predating this column stay null, meaning the self-approval check
  // simply cannot trigger for them — same "nullable, backward-compatible,
  // no redesign" treatment as every other additive inventory field this
  // engagement (InventoryMovement.franchiseId, InventoryAdjustmentRequest).
  requestedById     String?
  requestedBy       String?
  isDeleted         Boolean    @default(false)
  deletedAt         DateTime?
  franchise         Franchise? @relation(fields: [franchiseId], references: [id])
}

// INV-04 — a manual, single-location stock correction, deliberately not
// modeled on InventoryRequest (a two-location HQ<->franchise transfer with
// its own dispatch/receive steps that don't apply here). Shaped instead
// after MaterialConsumption's request/approve/reject pattern: single-step,
// stock only changes at approval, requester and approver always distinct.
model InventoryAdjustmentRequest {
  id            String    @id @default(cuid())
  itemId        String
  requestedQty  Int       // signed: positive adds stock, negative removes it
  reason        String
  status        String    @default("Pending") // Pending | Approved | Rejected | Cancelled
  requestedById String?
  requestedBy   String?
  approvedById  String?
  approvedBy    String?
  approvedAt    DateTime?
  rejectionNote String?
  franchiseId   String?
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  franchise     Franchise? @relation(fields: [franchiseId], references: [id])
}

model Appointment {
  id              String     @id
  customerId      String?
  customerName    String
  vehicle         String
  scheduledDate   DateTime
  service         String
  status          String     // "Scheduled", "Confirmed", "Rescheduled", "Cancelled", "Completed", "No Show"
  assignedStaff   String?
  assignedStaffId String?
  franchiseId     String?
  isDeleted       Boolean    @default(false)
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt
  franchise       Franchise? @relation(fields: [franchiseId], references: [id])
}

model UserPermission {
  id         String   @id @default(cuid())
  employeeId String   @unique
  modules    String[]
  // Pre-flight Patch C (Phase 1) — action-level override, Option 1 (sentinel
  // boolean + native array; Prisma has no nullable-list type, P1012).
  //   actionsOverride=false            -> no employee override, inherit RolePermission.actions
  //   actionsOverride=true, actions=[] -> explicit override: zero action grants
  //   actionsOverride=true, actions=[..] -> explicit employee-specific grants
  actions         String[] @default([])
  actionsOverride Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model RolePermission {
  role        String   @id
  permissions String[]
  // Pre-flight Patch C (Phase 1) companion field — role-level default action
  // grants. Left @default([]) for every role until Phase 1B's reviewed
  // permission matrix populates it; nothing reads this yet outside the new
  // resolver, and the resolver's own fail-closed default (empty matrix ->
  // deny) means adding this column changes no current behavior.
  actions     String[] @default([])
}

model MemberTransferRequest {
  id              String    @id @default(cuid())
  employeeId      String?
  fromFranchiseId String?
  toFranchiseId   String?
  requestedBy     String
  date            DateTime
  status          String
  username        String?
  password        String?
  newMemberName   String?
  newMemberPhone  String?
  newMemberEmail  String?
  role            String?
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  module    String   // "LEAD", "INVOICE", "CUSTOMER", "JOB", "INVENTORY", "LICENSE", "TRANSFER"
  recordId  String
  action    String   // "CREATE", "UPDATE", "DELETE", "RESTORE", "APPROVE", "REJECT", "TRANSFER"
  userId    String
  branchId  String?
  oldValue  Json?
  newValue  Json?
  ipAddress String?
  device    String?
  createdAt DateTime @default(now())
}

model InventoryMovement {
  id          String   @id @default(cuid())
  itemId      String
  type        String   // "ADD", "ADJUST", "DISPATCH", "RECEIVE", "CONSUME", "PURCHASE_RECEIPT"
  reference   String   // e.g. "INV-001", "REQ-002"
  quantity    Int
  balance     Int
  performedBy String
  performedAt DateTime @default(now())
  // INV-02 — additive, nullable. Populated on every new movement going
  // forward (DISPATCH carries the *destination* franchise; every other
  // type carries the affected item's own franchiseId; HQ-only movements
  // are null). Historical rows predating this column stay null forever —
  // callers must keep the itemId -> Inventory.franchiseId join as a
  // fallback for those, never assume this column is populated.
  franchiseId String?
}

model License {
