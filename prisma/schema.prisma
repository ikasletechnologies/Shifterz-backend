// REP-01C (D-REP5) — minimum viable dashboard widget configuration:
// HQ-controlled visibility + display order only, no layout engine, no
// per-franchise customization (explicitly out of scope per D-REP5). One
// row per (dashboardType, widgetKey) pair; dashboardType matches the D-21
// dashboard classes ("executive", "reception", "workshop", "qc",
// "billing", "inventory") plus "franchise" for the canonical §16.4
// Franchise Dashboard. A missing row for a given widgetKey means
// "visible, default order" — callers merge against each dashboard's own
// known widget-key list, so this table never needs to be pre-seeded.
model DashboardWidgetConfig {
  id            String   @id @default(cuid())
  dashboardType String
  widgetKey     String
  visible       Boolean  @default(true)
  order         Int      @default(0)
  updatedBy     String?
  updatedAt     DateTime @default(now()) @updatedAt
  createdAt     DateTime @default(now())

  @@unique([dashboardType, widgetKey])
}

