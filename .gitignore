# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# E2E fixture credentials generated per-run by scripts/e2e-qc-templates-fixtures-setup.ts
# (disposable test-only data, never real credentials, but generated/machine-specific)
scripts/e2e-qc-templates-fixtures.json

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# compiled prisma.config.ts (excluded from the src build; must not shadow the .ts source)
/prisma.config.js
/prisma.config.js.map
/prisma.config.d.ts
/prisma.config.d.ts.map

# logs
logs/
*.log

# uploaded photos — dev fallback dir when UPLOAD_DIR isn't set; real
# storage lives outside the repo (see UPLOAD_DIR in src/config/env.ts)
public/uploads/*
!public/uploads/.gitkeep
